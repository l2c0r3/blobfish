@startuml

top to bottom direction

set namespaceSeparator none

package "ch.hslu.cas.msed.blobfish.base" {
    interface EvaluationStrategy << interface >> {
      + getEvaluation(ChessBoard): int
    }
}

package "ch.hslu.cas.msed.blobfish.eval" {
    class CompositeEvaluationStrategy {
      + builder(): Builder
      + getStrategies(): List<Class<EvaluationStrategy>>
      + getEvaluation(ChessBoard): int
    }
    class MateAwareEvaluation {
      + getEvaluation(ChessBoard): int
    }
    class MaterialEvaluation {
      + getEvaluation(ChessBoard): int
      - removeEmptyFieldsFromPosition(String): String
      - parseFen(String): List<Piece>
    }
    class PieceSquareEvaluation {
      + getEvaluation(ChessBoard): int
      - getPieceValue(int, Piece, boolean): int
      - getPstForPiece(Piece, boolean): int[]
    }
}

EvaluationStrategy -[hidden]down- CompositeEvaluationStrategy

CompositeEvaluationStrategy  -[dashed]-^  EvaluationStrategy
MateAwareEvaluation          -[dashed]-^  EvaluationStrategy
MaterialEvaluation           -[dashed]-^  EvaluationStrategy
PieceSquareEvaluation        -[dashed]-^  EvaluationStrategy

@enduml
