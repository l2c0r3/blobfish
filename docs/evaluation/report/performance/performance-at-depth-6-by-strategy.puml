@startchart
skinparam dpi 300
scale 1.5

title
Median calculation time at depth 6
end title

h-axis [ MiniMax\nSequential\nWithCache,MiniMax\nSequential,MiniMax\nParallel\nWithCache,MiniMax\nParallel,MiniMax\nAlphaBeta\nSequential\nWithCache,MiniMax\nAlphaBeta\nSequential ]
v-axis "Calculation time [ms]" 0 --> 6.0 ticks [0:"1", 1:"10", 2:"100", 3:"1000", 4:"10'000", 5:"100'000", 6:"1'000'000"] label-top


bar "Mate aware piece square evaluation"[ 1.0E-5,1.0E-5,1.0E-5,1.0E-5,3.255,3.426 ] #1F77B4
bar "Mate aware piece square material evaluation"[ 1.0E-5,1.0E-5,1.0E-5,1.0E-5,3.371,3.503 ] #FF7F0E
bar "Mate aware material evaluation"[ 1.0E-5,1.0E-5,1.0E-5,1.0E-5,3.055,3.204 ] #2CA02C

legend right

<style>
chartDiagram {
    bar {
        LineThickness 1
    }
    axis {
        LineColor #34495e
        LineThickness 1.5
        FontSize 11
    }
    grid {
        LineColor #dddddd
        LineThickness 1
    }
}
</style>
@endchart
